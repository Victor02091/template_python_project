# ruff: noqa
import subprocess
from pathlib import Path

# ==============================================================================
# 1. INITIALIZE GIT & MAKE FIRST COMMIT
# ==============================================================================
if not Path(".git").exists():
    subprocess.run(["git", "init"], capture_output=True, check=False)

res = subprocess.run(
    ["git", "ls-files", ".copier-answers.yml", "--error-unmatch"],
    capture_output=True,
    check=False,
)
if res.returncode != 0:
    subprocess.run(["git", "add", "."], capture_output=True, check=False)
    
    # Un-stage this setup script before committing
    script_name = Path(__file__).name
    subprocess.run(
        ["git", "rm", "--cached", script_name],
        capture_output=True,
        check=False,
    )
    
    subprocess.run(
        ["git", "commit", "--no-verify", "-m", "chore: initial commit from template"],
        capture_output=True,
        check=False,
    )


# ==============================================================================
# 2. INSTALL PRE-COMMIT HOOKS
# ==============================================================================
{% if install_pre_commit_hooks | default(false) %}
try:
    subprocess.run(
        ["uv", "run", "pre-commit", "install"],
        capture_output=True,
        check=False,
    )
except Exception:
    pass
{% endif %}


# ==============================================================================
# 3. PRINT SUCCESS MESSAGE
# ==============================================================================
print("\n\033[0;32m✨ Project {{ project_name }} successfully generated! \033[0m\n")
print("Next steps:")

{% if not install_dependencies %}
print("  🚀 Get started:")
print("       1. \033[36muv sync\033[0m")
print("       2. \033[36muv run start-app\033[0m")
{% else %}
print("  🚀 Get started:")
print("       ▶  \033[36muv run start-app\033[0m")
{% endif %}

{% if add_docs %}
print("\n  📚 Documentation:")
print("       Build:  \033[36muv run --group docs mkdocs build --clean\033[0m")
print("       Serve:  \033[36muv run --group docs mkdocs serve\033[0m")
{% endif %}


# ==============================================================================
# 4. SELF-DESTRUCT
# ==============================================================================
try:
    Path(__file__).unlink(missing_ok=True)
except Exception:
    pass